# 本地开发默认使用 SQLite + 本地 blob 目录，无需额外服务。
# Docker Compose 会覆盖为 PostgreSQL + MinIO。

# DATABASE_URL=sqlite:////absolute/path/to/backend/storage/meta.db
# STORAGE_BACKEND=local
# BLOB_ROOT=./storage/blobs

# PostgreSQL（Docker / 生产）
# DATABASE_URL=postgresql://workbench:workbench@localhost:5432/workbench

# MinIO（Docker / 生产）
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=industrial-models
# MINIO_SECURE=false

# 旧版 pickle / registry.json 所在目录（启动时自动导入）
# LEGACY_STORAGE_DIR=./storage
